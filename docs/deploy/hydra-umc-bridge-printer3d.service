# The bridge coordinates a 3D printer through Moonraker; it never streams G-code. The configuration is
# /etc/hydra-umc-bridge-printer3d/bridge-printer3d.toml (example: docs/deploy/bridge-printer3d.example.toml); the MQTT credentials and the
# Moonraker API key go in /etc/hydra-umc/bridge-printer3d.env (readable by root only). With no valid configuration the
# unit does nothing: ConditionPathExists skips it without a file, and ExecStartPre fails on an invalid one.
# The account of the service cannot enter the shared /etc/hydra-umc (mode 0750, group of the agent), so systemd creates /etc/hydra-umc-bridge-printer3d
# for this unit alone (mode 0750). A configuration file of the earlier place (/etc/hydra-umc/bridge-printer3d.toml) is copied there once, as root, by the first
# ExecStartPre, which never overwrites and never deletes; the second ExecStartPre proves the account of the service can read it. The environment file
# may stay in /etc/hydra-umc or go to /etc/hydra-umc-bridge-printer3d (systemd reads both as root).
[Unit]
Description=HYDRA-UMC-BRIDGE-PRINTER3D 3D-printer coordination and job gate
After=network-online.target
Wants=network-online.target
ConditionPathExists=|/etc/hydra-umc-bridge-printer3d/bridge-printer3d.toml
ConditionPathExists=|/etc/hydra-umc/bridge-printer3d.toml

[Service]
Type=simple
User=hydra-umc-bridge-printer3d
Group=hydra-umc-bridge-printer3d
WorkingDirectory=/opt/hydra-umc/bridge-printer3d
Environment=PYTHONPATH=/opt/hydra-umc/bridge-printer3d/src
Environment=HYDRA_UMC_BRIDGE_PRINTER3D_CONFIG=/etc/hydra-umc-bridge-printer3d/bridge-printer3d.toml
EnvironmentFile=-/etc/hydra-umc/bridge-printer3d.env
EnvironmentFile=-/etc/hydra-umc-bridge-printer3d/bridge-printer3d.env
ExecStartPre=+/usr/bin/python3 -m hydra_umc_bridge_printer3d --prepare-config
ExecStartPre=/usr/bin/python3 -m hydra_umc_bridge_printer3d --check-access
ExecStartPre=/usr/bin/python3 -m hydra_umc_bridge_printer3d --check
ExecStart=/usr/bin/python3 -m hydra_umc_bridge_printer3d
Restart=on-failure
RestartSec=5
StateDirectory=hydra-umc-bridge-printer3d
ConfigurationDirectory=hydra-umc-bridge-printer3d
ConfigurationDirectoryMode=0750
RuntimeDirectory=hydra-umc
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed
MemoryAccounting=yes
MemoryHigh=128M
MemoryMax=192M

[Install]
WantedBy=multi-user.target
